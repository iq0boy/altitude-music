---
// Latest Instagram posts, synced into the repo by scripts/sync-instagram.mjs
// (daily GitHub Action). Pictures live in src/assets/instagram/ and are optimised
// by Astro; each tile links to the post on Instagram. Renders nothing when empty.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Translations } from '../i18n/utils';
import posts from '../data/instagram.json';

interface Props { t: Translations; }
const { t } = Astro.props;

const HANDLE = 'alt_itude.music';
const pictures = import.meta.glob<{ default: ImageMetadata }>('../assets/instagram/*.jpg', { eager: true });
const items = (posts as { id: string; type: string; permalink: string; caption: string; timestamp: string; image: string }[])
  .map(p => ({ ...p, img: pictures[`../assets/instagram/${p.image}`]?.default }))
  .filter(p => p.img);
---
{items.length > 0 && (
  <div class="ig">
    <div class="ig-head">
      <div>
        <div class="section-tag reveal">{t.sections.instagram}</div>
        <div class="ig-sub">{t.sections.instagramSub}</div>
      </div>
      <a class="btn ghost" href={`https://www.instagram.com/${HANDLE}/`} target="_blank" rel="noopener">@{HANDLE} →</a>
    </div>
    <div class="ig-grid">
      {items.map(p => (
        <a class="ig-tile" href={p.permalink} target="_blank" rel="noopener" aria-label={p.caption || `Instagram @${HANDLE}`}>
          <Image src={p.img!} alt={p.caption || ''} width={640} loading="lazy" decoding="async" />
          {p.type === 'reel' && <span class="ig-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>}
          <span class="ig-type">{p.type === 'reel' ? 'REEL' : p.type === 'carousel' ? 'CARROUSEL' : 'POST'}</span>
        </a>
      ))}
    </div>
  </div>
)}
